# Configuración para My Suite In Cartagena
RewriteEngine On

# Redirección automática
RewriteRule ^$ index.php [L]

# Manejo de errores 404
ErrorDocument 404 index.php

# Configuración de PHP (solo si está permitido en tu hosting)
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>

# Seguridad
Options -Indexes
ServerSignature Off

# Headers de seguridad (menos restrictivo)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    # Cambiar DENY por SAMEORIGIN para evitar problemas
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Configure el paquete “alt-php82” como el lenguaje de programación predeterminado “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
